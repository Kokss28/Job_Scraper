# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/

# Environment variables & secrets (KEEP .env.example tracked, IGNORE real secrets)
.env
.env.*
!.env.example
web/.env*
!web/.env.example

# Next.js & Frontend builds
web/.next/
web/out/
web/node_modules/
node_modules/
*.tsbuildinfo
next-env.d.ts

# Data outputs, databases, and local tracking files
Data/*
!Data/Date/
!Data/Date/**
*.csv
!Data/Date/**/*.csv
!Data/Date/*.csv
!Data/extraction_history.csv
*.db
*.pdf
*.json
!package.json
!package-lock.json
!tsconfig.json
!web/**/*.json

# Playwright Test Output Artifacts
web/public/test_screenshots/
web/public/test_screenshots/*

# Debug logs or crawler temporary folders
naukri_debug/
*.log
npm-debug.log*

# OS & Editor specific files
.DS_Store
Thumbs.db
.vscode/
.idea/
