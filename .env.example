# Copy this file to .env and adjust as needed.

# Where the unified CSV + dedup state file are written.
PIPELINE_OUTPUT_DIR=Data

# ---- LinkedIn ----
LINKEDIN_LOCATION=India
LINKEDIN_MAX_JOBS_PER_KEYWORD=100
LINKEDIN_JOBS_PER_PAGE=25
LINKEDIN_MAX_AGE_HOURS=1

# ---- Naukri ----
NAUKRI_MAX_PAGES=5
NAUKRI_MAX_JOBS=100
NAUKRI_MAX_TOTAL=
NAUKRI_DELAY_SECONDS=2.0
NAUKRI_HEADLESS=true
NAUKRI_BROWSER=chromium
NAUKRI_PROFILE_DIR=

# ---- Indeed ----
INDEED_LOCATION=India
INDEED_MAX_JOBS_PER_KEYWORD=50
INDEED_MAX_AGE_HOURS=168

# ---- Supabase Cloud Database (Option A) ----
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ---- Automated Email & Alert Notifications (Gmail SMTP) ----
# How to get Google App Password:
# 1. Open Google Account (myaccount.google.com) -> Security
# 2. Turn on 2-Step Verification (if not already enabled)
# 3. Search "App passwords" -> Create new app password (Name: "Job Scraper")
# 4. Paste the 16-character password below (e.g., abcd efgh ijkl mnop)
GMAIL_USER=thoorigai.cons.ttk@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
ALERT_RECIPIENT_EMAIL=thoorigai.cons.ttk@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


